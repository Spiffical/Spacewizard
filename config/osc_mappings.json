      "description": "Energy rises with motion activity"
    },
    {
      "enabled": false,
      "source": "accel_x",
      "osc": "live_brightness"
    },
    {
      "enabled": false,
      "source": "accel_y",
      "osc": "live_variance"
    },
    {
