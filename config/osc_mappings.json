    },
    {
      "enabled": false,
      "source": "roll_angle",
      "osc": "live_decay"
    },
    {
      "enabled": false,
      "source": "baseline_deviation",
      "osc": "live_energy"
    },
    {
      "enabled": false,
      "source": "impact_event",
      "osc": "trigger_strobe",
      "description": "Impact trigger -> strobe"
    },
    {
      "enabled": true,
      "source": "pickup_event",
      "osc": "trigger_strobe",
      "description": "One-shot strobe on pickup"
    }
