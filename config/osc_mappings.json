        "source": "gyroscope_x",
        "scale_min": -500.0,
        "scale_max": 500.0,
        "invert": false
      },
      "gyro_y": {
        "source": "gyroscope_y",
        "scale_min": -500.0,
        "scale_max": 500.0,
        "invert": false
      },
