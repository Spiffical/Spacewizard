    {
      "enabled": false,
      "source": "gyro_mag",
      "osc": "live_motion_speed"
    },
    {
      "enabled": false,
      "source": "yaw_angle",
      "osc": "live_shape"
    },
    {
      "enabled": true,
      "source": "pitch_angle",
      "osc": "live_variance",
